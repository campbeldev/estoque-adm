# Copie este arquivo para `.env` e troque as senhas antes de subir.
POSTGRES_USER=estoque_adm
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=estoque_adm

# "db" é o nome do serviço no docker-compose (rede interna do container).
# Este valor é usado pelo APP dentro do container.
# Para a migração a partir da máquina (host), use o mesmo usuário/senha mas
# com host "localhost" e porta "5434":  ...@localhost:5434/estoque_adm
DATABASE_URL=postgresql+psycopg://estoque_adm:troque-esta-senha@db:5432/estoque_adm

# Chave de sessão/CSRF — gere uma aleatória bem longa em produção.
SECRET_KEY=uma-chave-aleatoria-bem-longa
